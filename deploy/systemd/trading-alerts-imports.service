[Unit]
Description=Trading alerts imports
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/quant/repos/market-watch
ExecStart=/home/quant/repos/market-watch/.venv/bin/python -m alerts.market --imports-only
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
