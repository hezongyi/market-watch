[Unit]
Description=Trading alerts api
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/quant/repos/market-watch
Environment=ALERTS_PUBLIC_URL=http://192.168.7.232:8080
ExecStart=/home/quant/repos/market-watch/.venv/bin/uvicorn alerts.site:app --host 0.0.0.0 --port 8080 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
