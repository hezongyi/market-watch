# Prepare the official ntfy binary with checksums.txt before this build.
FROM python:3.11-slim-bookworm
COPY ntfy /usr/local/bin/ntfy
USER 1000:1000
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/ntfy"]
CMD ["serve", "--listen-http", ":8080", "--cache-file", "/var/cache/ntfy/cache.db", "--cache-duration", "24h"]
