# Generate a password hash using python -m alerts.cli init. Never commit .env.
ALERTS_ADMIN_PASSWORD_HASH=
ALERTS_DATABASE_URL=sqlite:///./alerts.db
ALERTS_PUBLIC_URL=http://localhost:8000
ALERTS_COOKIE_SECURE=false
ALERTS_DELIVERY_ENABLED=false
ALERTS_NTFY_URL=https://ntfy.sh
ALERTS_NTFY_TOPIC=
ALERTS_NTFY_TOKEN=
ALERTS_MARKET_PROXY=
# Binance uses ALERTS_MARKET_PROXY by default; set this to override it.
ALERTS_BINANCE_PROXY=
# Production: HTTPS public URL, secure cookies and a URL-safe database password.
POSTGRES_PASSWORD=

ALERTS_OANDA_TOKEN=
ALERTS_OANDA_ACCOUNT_ID=
ALERTS_OANDA_PROXY=

# Applies only when creating new instrument records; never rewrites existing history.
ALERTS_FX_SOURCE=oanda

ALERTS_MARKET_POLL_SECONDS=15
ALERTS_IMPORT_POLL_SECONDS=30
# One-time background warmup, newest daily slices first. 0 disables automatic setup.
ALERTS_INITIAL_HISTORY_DAYS=180
# Optional directory containing pg_dump/pg_restore matching the PostgreSQL major version.
ALERTS_POSTGRES_BIN_DIR=

# Per-process PostgreSQL connection budget; account for every API/worker process.
ALERTS_DATABASE_POOL_SIZE=2
ALERTS_DATABASE_MAX_OVERFLOW=0
ALERTS_DATABASE_POOL_TIMEOUT=15
ALERTS_DATABASE_APPLICATION_NAME=market-watch

# Independent provider range cache; foreground reads wait only for native demand.
ALERTS_PROVIDER_REQUEST_SECONDS=8
ALERTS_PROVIDER_FRESH_SECONDS=15
ALERTS_PROVIDER_BASIC_BARS=1000
ALERTS_PROVIDER_DEPTH_BARS=4000
ALERTS_PROVIDER_ACTIVITY_SECONDS=600
ALERTS_PROVIDER_SUBSCRIPTION_SECONDS=60
# Pending read interests per session; subscribed listeners are preserved.
ALERTS_PROVIDER_INTEREST_LIMIT=16
ALERTS_PROVIDER_CACHE_DAYS=7
ALERTS_PROVIDER_CACHE_MAX_BARS=1000000
