//@version=6
indicator("Rolling Range Squeeze", overlay = true, max_boxes_count = 500, max_labels_count = 500)

//====================
// Inputs
//====================
k              = input.int(10, "K", minval = 1)
lookback       = input.int(252, "Percentile Lookback", minval = 20)
lowPct         = input.float(5.0, "Lowest Percentile (%)", minval = 0.1, maxval = 50.0, step = 0.1)
confirmOnClose = input.bool(true, "Only confirm on bar close")

firstBoxBorderColor = input.color(color.green, "First Signal Box Border")
firstBoxFillColor   = input.color(color.new(color.green, 82), "First Signal Box Fill")

nextBoxBorderColor  = input.color(color.orange, "Extension Box Border")
nextBoxFillColor    = input.color(color.new(color.orange, 82), "Extension Box Fill")

smaColor       = input.color(color.blue, "SMA Color")
labelBgColor   = input.color(color.new(color.green, 55), "Label Background")
labelTextColor = input.color(color.white, "Label Text Color")

//====================
// Core calc
//====================
rollingHigh = ta.highest(high, k)
rollingLow  = ta.lowest(low, k)
closeSma    = ta.sma(close, k)

squeezeRatio = not na(closeSma) and closeSma != 0 ? (rollingHigh - rollingLow) / closeSma : na

plot(closeSma, title = "SMA(Close, K)", color = smaColor, linewidth = 2)

//====================
// Historical ratio queue
//====================
var array<float> ratios = array.new<float>()

enoughHistory = array.size(ratios) >= lookback
threshold     = enoughHistory ? array.percentile_nearest_rank(ratios, lowPct) : na

rawSignal = enoughHistory and not na(squeezeRatio) and squeezeRatio <= threshold
signal    = rawSignal and (not confirmOnClose or barstate.isconfirmed)

//====================
// PctRank
//====================
float pctRank = na
if enoughHistory and not na(squeezeRatio)
    int leCount = 0
    for i = 0 to array.size(ratios) - 1
        if array.get(ratios, i) <= squeezeRatio
            leCount += 1
    pctRank := leCount * 100.0 / array.size(ratios)

//====================
// Segment state
//====================
var bool  prevSignal      = false
var int   segmentLeft     = na
var float segmentTop      = na
var float segmentBottom   = na
var int   segmentFirstBar = na

var box   activeGreenBox  = na
var box   activeYellowBox = na

firstInSegment = signal and not prevSignal

//====================
// Draw logic
// 按 bar_index 画，不延长K
//====================
if signal
    currentLeft = bar_index - k + 1

    if firstInSegment
        segmentLeft     := currentLeft
        segmentTop      := rollingHigh
        segmentBottom   := rollingLow
        segmentFirstBar := bar_index
        activeYellowBox := na
        activeGreenBox  := na

        // 第一根信号：绿色首框
        activeGreenBox := box.new(
             left = segmentLeft,
             top = segmentTop,
             right = segmentFirstBar,
             bottom = segmentBottom,
             border_color = firstBoxBorderColor,
             border_width = 2,
             bgcolor = firstBoxFillColor
         )

        // label 只显示 PctRank
        label.new(
             x = segmentFirstBar,
             y = segmentTop,
             text = "PctRank: " + str.tostring(pctRank, "#.##") + "%",
             style = label.style_label_down,
             color = labelBgColor,
             textcolor = labelTextColor,
             size = size.small
         )

    else
        // 第二根及以后：黄色整段框，从第一根信号对应的 K 起点开始画
        if na(activeYellowBox)
            activeYellowBox := box.new(
                 left = segmentLeft,
                 top = segmentTop,
                 right = bar_index,
                 bottom = segmentBottom,
                 border_color = nextBoxBorderColor,
                 border_width = 2,
                 bgcolor = nextBoxFillColor
             )
        else
            box.set_left(activeYellowBox, segmentLeft)
            box.set_right(activeYellowBox, bar_index)
            box.set_top(activeYellowBox, segmentTop)
            box.set_bottom(activeYellowBox, segmentBottom)

        // 绿色首框重画到最上层，避免被黄色覆盖
        if not na(activeGreenBox)
            box.delete(activeGreenBox)

        activeGreenBox := box.new(
             left = segmentLeft,
             top = segmentTop,
             right = segmentFirstBar,
             bottom = segmentBottom,
             border_color = firstBoxBorderColor,
             border_width = 2,
             bgcolor = firstBoxFillColor
         )

// 段结束：只清空活动句柄，不删除历史框
if prevSignal and not signal
    activeGreenBox  := na
    activeYellowBox := na
    segmentLeft     := na
    segmentTop      := na
    segmentBottom   := na
    segmentFirstBar := na

prevSignal := signal

//====================
// Update history after bar close
//====================
if barstate.isconfirmed and not na(squeezeRatio)
    array.push(ratios, squeezeRatio)
    if array.size(ratios) > lookback
        array.shift(ratios)

//====================
// Alert
//====================
alertcondition(signal, title = "Rolling Range Squeeze", message = "Rolling Range Squeeze triggered")