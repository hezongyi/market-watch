FROM node:22-bookworm-slim AS build
WORKDIR /web
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build:login-preview
FROM nginx:1.28-alpine
COPY --from=build /web/dist /usr/share/nginx/html
COPY vendor/favicon.svg /usr/share/nginx/html/favicon.svg
COPY src/app/MAGIC_UI_LICENSE.md /usr/share/nginx/html/MAGIC_UI_LICENSE.md
COPY login-preview.html /usr/share/nginx/html/login-preview.html
COPY login-preview.nginx.conf /etc/nginx/conf.d/default.conf
